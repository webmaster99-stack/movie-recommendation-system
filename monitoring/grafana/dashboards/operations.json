    {
      "id": 9,
      "type": "table",
      "title": "Endpoints",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "recsys-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "recsys-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select method, route, count(*) as requests, 100.0 * count(*) filter (where status >= 500) / count(*) as \"5xx\", 100.0 * count(*) filter (where status between 400 and 499) / count(*) as \"4xx\", percentile_cont(0.5) within group (order by latency_ms) as median, percentile_cont(0.95) within group (order by latency_ms) as p95, max(latency_ms) as slowest from monitoring.requests where $__timeFilter(created_at) group by 1, 2 order by requests desc"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "noValue": "\u2013"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "4xx"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "median"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "slowest"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "4xx includes requests without a valid sign-in (401) and addresses that do not exist, listed as (unmatched)."
