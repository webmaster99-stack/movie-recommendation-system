          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select $__timeGroupAlias(created_at, $__interval), (status / 100)::text || 'xx' as metric, count(*) as responses from monitoring.requests where $__timeFilter(created_at) group by 1, 2 order by 1"
        }
