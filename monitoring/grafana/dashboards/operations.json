            "uid": "recsys-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select percentile_cont(0.5) within group (order by latency_ms) as p50 from monitoring.requests where $__timeFilter(created_at)"
