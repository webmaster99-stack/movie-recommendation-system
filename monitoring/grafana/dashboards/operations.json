          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select $__timeGroupAlias(created_at, $__interval), route as metric, count(*) as requests from monitoring.requests where $__timeFilter(created_at) group by 1, 2 order by 1"
