    {
      "id": 3,
      "type": "stat",
      "title": "Click-through rate",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "recsys-postgres"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "recsys-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select 100.0 * count(*) filter (where n_clicks > 0) / nullif(count(*), 0) as ctr from monitoring.recommendations where $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "\u2013",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "Share of lists with at least one click on a recommended movie."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Hit rate",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "recsys-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "recsys-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select 100.0 * count(*) filter (where best_rating_after is not null) / nullif(count(*), 0) as hit_rate from monitoring.recommendations where $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "\u2013",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "Share of lists from which the user later rated at least one movie, whether or not they opened it from the list."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Catalog coverage",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "recsys-postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "recsys-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select 100.0 * (select count(distinct movie_id) from monitoring.served_movies where $__timeFilter(created_at)) / nullif((select max(catalog_size) from monitoring.recommendations where $__timeFilter(created_at)), 0) as coverage"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "\u2013",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "Share of the catalog that appeared in at least one list."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Popularity of what is shown",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "recsys-postgres"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "recsys-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select 100.0 * avg(popularity_percentile) as place from monitoring.recommendations where $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "\u2013",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "Mean place of the recommended movies in the model's popularity order: 0% means only the most popular movie is ever shown, 50% would be no preference for popular movies at all."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Lists per day",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "recsys-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "recsys-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select $__timeGroupAlias(created_at, '1d'), strategy as metric, count(*) as lists from monitoring.recommendations where $__timeFilter(created_at) group by 1, 2 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "'popular' is the fallback for a user with no liked movies yet: the same list for everyone."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Click-through and hit rate per day",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "recsys-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "recsys-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select $__timeGroupAlias(created_at, '1d'), 100.0 * count(*) filter (where n_clicks > 0) / count(*) as \"click-through rate\", 100.0 * count(*) filter (where best_rating_after is not null) / count(*) as \"hit rate\" from monitoring.recommendations where $__timeFilter(created_at) group by 1 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": ""
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Time to score a user",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "recsys-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "recsys-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select $__timeGroupAlias(created_at, $__interval), percentile_cont(0.5) within group (order by model_ms) as \"model, median\", percentile_cont(0.95) within group (order by model_ms) as \"model, 95th percentile\", percentile_cont(0.95) within group (order by latency_ms) as \"whole request, 95th percentile\" from monitoring.recommendations where $__timeFilter(created_at) group by 1 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "The model alone, and the whole request with the database and TMDB lookups.",
      "interval": "5m"
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Coverage and popularity per day",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "recsys-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "recsys-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select r.time, 100.0 * s.movies / nullif(r.catalog_size, 0) as \"catalog coverage\", r.place as \"popularity place\" from (select $__timeGroup(created_at, '1d') as time, max(catalog_size) as catalog_size, 100.0 * avg(popularity_percentile) as place from monitoring.recommendations where $__timeFilter(created_at) group by 1) r join (select $__timeGroup(created_at, '1d') as time, count(distinct movie_id) as movies from monitoring.served_movies where $__timeFilter(created_at) group by 1) s using (time) order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": ""
    },
    {
      "id": 11,
      "type": "barchart",
      "title": "Liked movies behind each list",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "recsys-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "recsys-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select case when n_liked = 0 then '0' when n_liked < 10 then '1-9' when n_liked < 20 then '10-19' when n_liked < 50 then '20-49' when n_liked < 100 then '50-99' else '100+' end as \"liked movies\", count(*) as lists from monitoring.recommendations where $__timeFilter(created_at) group by 1 order by min(n_liked)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "tooltip": {
          "mode": "single"
        }
      },
      "description": "The length of the history the model was given. The app asks for ten ratings at sign-up; MovieLens users, whom the model was trained on, have far more."
    },
    {
      "id": 12,
      "type": "barchart",
      "title": "Clicks by place in the list",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "recsys-postgres"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "recsys-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select (position + 1)::text as place, count(*) as clicks from monitoring.events where $__timeFilter(created_at) and event_type = 'click' and from_recommendation and position is not null group by position order by position"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "tooltip": {
          "mode": "single"
        }
      },
      "description": "1 is the top of the list."
    },
    {
      "id": 13,
      "type": "barchart",
      "title": "Ratings given in the app",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "recsys-postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "recsys-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select to_char(rating, 'FM0.0') as stars, count(*) as ratings from monitoring.ratings where $__timeFilter(updated_at) group by rating order by rating"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "tooltip": {
          "mode": "single"
        }
      },
      "description": "3.5 stars and up count as a like for the model."
    },
    {
      "id": 14,
      "type": "table",
      "title": "Most recommended movies",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "recsys-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "recsys-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select movie_id, count(*) as \"times shown\", 100.0 * count(*) / (select count(*) from monitoring.recommendations where $__timeFilter(created_at)) as \"share of lists\", avg(position) + 1 as \"mean place\" from monitoring.served_movies where $__timeFilter(created_at) group by 1 order by 2 desc, 1 limit 25"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "noValue": "\u2013"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "share of lists"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mean place"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "By MovieLens id: /movies/<id> in the app. Titles come from TMDB and are kept out of monitoring."
    },
    {
      "id": 15,
      "type": "table",
      "title": "Models served",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "recsys-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "recsys-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select model, model_version as version, count(*) as lists, min(created_at) as \"first list\", max(created_at) as \"last list\" from monitoring.recommendations where $__timeFilter(created_at) group by 1, 2 order by 5 desc"
