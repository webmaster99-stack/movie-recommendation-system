{
  "uid": "recsys-recommendations",
  "title": "Movie recommender: recommendations",
  "description": "What is recommended and what users do with it. A 'list' is one answer of /recommendations. Offline metrics say how well the model predicts held-out likes; these say what happens in the app.",
  "tags": [
    "movie-recsys"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
