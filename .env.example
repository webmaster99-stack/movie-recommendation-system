# Copy to .env and fill in. Everything is optional for a local run:
# without these, MLflow logs to a local mlflow.db (view it with `uv run mlflow ui --backend-store-uri sqlite:///mlflow.db`).

# MLflow on DagsHub (https://dagshub.com/<user>/<repo>.mlflow)
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# --- API (api/recsys_api/config.py lists every setting) ---

# TMDB (used only by the API to show posters; experiments never need it).
# Either the v3 API key or the v4 read access token. Without it, movies have no posters.
TMDB_API_KEY=

# Postgres. Use Supabase's *session pooler* string (Connect > Session pooler): the direct
# connection is IPv6-only, which Render can't reach. Unset, the API uses a local SQLite file.
DATABASE_URL=

# Supabase project URL (https://<ref>.supabase.co): access tokens are checked against its
# public signing keys. Only projects still on the legacy shared secret need the second value.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Origins allowed to call the API from a browser, comma-separated. On Render: the Vercel address.
CORS_ORIGINS=http://localhost:3000

# --- Monitoring (see "Monitoring" in the README) ---

# The read-only `monitoring_reader` role: Supabase's session pooler string with the user
# `monitoring_reader.<project ref>` and the password you gave the role. Read by the drift
# report and by scripts/grafana_sync.py, which hands it to Grafana as its data source.
MONITORING_DATABASE_URL=

# Grafana Cloud: the stack's address (https://<stack>.grafana.net) and a service account
# token with the Admin role (it creates the data source and alert rules). Only
# scripts/grafana_sync.py uses them.
GRAFANA_URL=
GRAFANA_TOKEN=

# Deployment needs no further values here. The Deploy workflow reads the three MLFLOW_*
# values above from GitHub secrets, plus RENDER_DEPLOY_HOOK_URL (secret) and API_URL
# (variable); see "Deployment" in the README.
