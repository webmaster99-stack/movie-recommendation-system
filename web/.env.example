# Copy to .env.local. All three are public values: they end up in the browser's JavaScript.

# The FastAPI service (`uv run uvicorn recsys_api.main:create_app --factory --app-dir api`).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase, for sign-in only: Project Settings > API. The publishable key (sb_publishable_...)
# is safe to expose; row-level security decides what it can read. Never put the secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
